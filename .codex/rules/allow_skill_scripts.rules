# Allow running skill scripts without prompts.
prefix_rule(
    pattern = ["python3", ".agents/skills/pr/scripts/get_pr_data.py"],
    decision = "allow",
    justification = "Allow PR skill script without prompts.",
    match = [
        "python3 .agents/skills/pr/scripts/get_pr_data.py ensure-setup",
        "python3 .agents/skills/pr/scripts/get_pr_data.py get-pr 354",
    ],
)

prefix_rule(
    pattern = ["python3", ".agents/skills/tondocs/scripts/tondocs.py"],
    decision = "allow",
    justification = "Allow TON docs skill script without prompts.",
    match = [
        "python3 .agents/skills/tondocs/scripts/tondocs.py sync",
        "python3 .agents/skills/tondocs/scripts/tondocs.py search jetton",
    ],
)
