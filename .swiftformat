--minversion 0.62.0
--swiftversion 5.0
--indent 4
--linebreaks lf
--commas always
--semicolons inline
--stripunusedargs closure-only
--trimwhitespace always
--disable redundantType
--disable redundantSelf
# `!x.isEmpty` does not always read better than `x.count > 0`, and the rewrite does not
# compile for NSMutableArray, which has no isEmpty.
--disable isEmpty
--wrapparameters before-first
--wraparguments before-first

# Rules enabled by default in 0.60–0.62 that rewrite existing code repo-wide.
--disable redundantSendable
--disable wrapIfStatementBodies
--disable redundantSwiftUIGroup
--disable redundantSwiftTestingSuite

--exclude .build
--exclude build
--exclude .swiftpm
--exclude worktrees
--exclude LocalPackages/TKCore/Sources/TKCore/Analytics/Events/Generated
--exclude LocalPackages/TKUIKit/TKUIKit/Sources/TKUIKit/Generated
--exclude LocalPackages/TKCore/Sources/TKCore/Analytics/Events/Deprecated
--exclude LocalPackages/KeeperCore/Packages/TonConnectAPI/Sources/TonConnectAPI
--exclude LocalPackages/KeeperCore/Packages/TKKandelabrAPI/Sources/TKKandelabrAPI
--exclude LocalPackages/KeeperCore/Packages/TKTradingAPI/Sources/TKTradingAPI
--exclude LocalPackages/KeeperCore/Packages/TKPerpsAPI/Sources/TKPerpsAPI
--exclude LocalPackages/KeeperCore/Packages/TKTonkeeperAPI/Sources/TKTonkeeperAPI
--exclude LocalPackages/KeeperCore/Packages/MultichainAPI/Sources/MultichainAPI
--exclude LocalPackages/KeeperCore/Packages/SwapAPI/Sources/SwapAPI
