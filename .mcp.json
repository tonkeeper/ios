{
  "mcpServers": {
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "maestro": {
      "type": "stdio",
      "command": "scripts/tools/maestro.sh",
      "args": ["mcp", "--working-dir=maestro_ui_tests"]
    },
    "xcode": {
      "type": "stdio",
      "command": "xcrun",
      "args": ["mcpbridge"]
    }
  }
}
