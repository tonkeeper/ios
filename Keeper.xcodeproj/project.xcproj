    }, {
      "name": "KeeperIntents",
      "id": "7DDBBFEA2ACCA10E00F811A5",
      "product": "Products/KeeperIntents.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        }, {
          "kind": "script",
          "name": "Drop shared TKUIKit resources",
          "log-environment-variables": true,
          "input-paths": [
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/KeeperResources_KeeperResources.bundle",
          ],
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "# Keeper.app holds a copy of this bundle, next to the shared TKUIKit framework;",
            "# SwiftPM still copies it into every product that links TKUIKit. KeeperResourcesBundle finds",
            "# the app's copy from this extension, so this one is dropped. The widget keeps its own: WidgetKit",
            "# draws its fonts (UIAppFonts) and images out of process, from the widget's bundle.",
            "rm -rf \"${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}/KeeperResources_KeeperResources.bundle\"",
            "",
          ],
        },
      ],
      "package-product-members": [
        {
          "product-name": "KeeperCore",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "TKBase",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "WalletExtensions",
          "product-name": "WalletExtensions",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
        "CODE_SIGN_ENTITLEMENTS": "KeeperIntents/KeeperIntents.entitlements",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "$(BUILD_NUMBER)",
        "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "KeeperIntents/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "KeeperIntents",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "LOCALIZATION_PREFERS_STRING_CATALOGS": "YES",
        "MARKETING_VERSION": "$(APP_VERSION)",
        "PRODUCT_BUNDLE_IDENTIFIER": "$(INTENTS_PRODUCT_BUNDLE_IDENTIFIER)",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SKIP_INSTALL": "YES",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
