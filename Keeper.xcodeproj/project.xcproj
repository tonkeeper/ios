  "targets": [
    {
      "name": "Keeper",
      "id": "7DB8FB612A1BCC92005B4B11",
      "product": "Products/Keeper.app",
      "product-type": "application",
      "dependencies": [
        "KeeperWidgetExtension",
        "KeeperIntents",
        "KeeperNotificationService",
      ],
      "build-phases": [
        {
          "kind": "script",
          "name": "Setup Hooks",
          "log-environment-variables": true,
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "set -e",
            "",
            "if [ -n \"$CI\" ]; then",
            "    exit 0",
            "fi",
            "",
            "make hooks -C \"${SRCROOT}\"",
            "",
          ],
        }, {
          "kind": "script",
          "name": "SwiftLint",
          "log-environment-variables": true,
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "set -e",
            "",
            "TOOL=\"${SRCROOT}/scripts/tools/tool.sh\"",
            "",
            "if ! \"$TOOL\" swiftlint --version >/dev/null 2>&1; then",
            "    echo \"warning: pinned SwiftLint not installed, skipping lint. Install it with: make setup\"",
            "    exit 0",
            "fi",
            "",
            "\"$TOOL\" swiftlint lint --config \"${SRCROOT}/.swiftlint.yml\"",
            "",
          ],
        },
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        }, {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        }, {
          "kind": "script",
          "name": "Link KeeperResources to the widget's copy",
          "log-environment-variables": true,
          "input-paths": [
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/KeeperResources_KeeperResources.bundle",
            "$(TARGET_BUILD_DIR)/$(PLUGINS_FOLDER_PATH)/KeeperWidgetExtension.appex",
          ],
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "set -e",
            "case \"${CONFIGURATION}\" in",
            "    *Release) ;;",
            "    *) exit 0 ;;",
            "esac",
            "",
            "# WidgetKit reads fonts (UIAppFonts) and images out of process, so the widget keeps",
            "# the real bundle. The app and intents share it through a relative symlink.",
            "# Without the widget's bundle, keep the app's copy.",
            "name=KeeperResources_KeeperResources.bundle",
            "target=\"PlugIns/KeeperWidgetExtension.appex/$name\"",
            "cd \"${TARGET_BUILD_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}\" || exit 1",
            "[ -d \"$target\" ] || exit 0",
            "rm -rf \"$name\"",
            "ln -s \"$target\" \"$name\"",
            "",
          ],
        }, {
          "kind": "script",
          "name": "Firebase plist",
          "log-environment-variables": true,
          "input-paths": [
            "$(SRCROOT)/scripts/firebase/copy_google_service_info.sh",
            "$(PROJECT_DIR)/$(TARGET_NAME)/Resources/Firebase/Keeper/GoogleService-Info.plist",
            "$(PROJECT_DIR)/$(TARGET_NAME)/Resources/Firebase/KeeperDev/GoogleService-Info.plist",
            "$(PROJECT_DIR)/$(TARGET_NAME)/Resources/Firebase/KeeperUK/GoogleService-Info.plist",
          ],
          "output-paths": [
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/GoogleService-Info.plist",
          ],
          "shell": "/bin/sh",
          "script": [
            "set -e",
            "",
            "\"${SRCROOT}/scripts/firebase/copy_google_service_info.sh\"",
            "",
          ],
        }, {
          "kind": "script",
          "name": "Crashlytics+dSYM",
          "log-environment-variables": true,
          "input-paths": [
            "${DWARF_DSYM_FOLDER_PATH}/${DWARF_DSYM_FILE_NAME}",
            "${DWARF_DSYM_FOLDER_PATH}/${DWARF_DSYM_FILE_NAME}/Contents/Resources/DWARF/${PRODUCT_NAME}",
            "${DWARF_DSYM_FOLDER_PATH}/${DWARF_DSYM_FILE_NAME}/Contents/Info.plist",
            "$(TARGET_BUILD_DIR)/$(UNLOCALIZED_RESOURCES_FOLDER_PATH)/GoogleService-Info.plist",
            "$(TARGET_BUILD_DIR)/$(EXECUTABLE_PATH)",
          ],
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "set -e",
            "",
            "case \"${CONFIGURATION}\" in",
            "    *Release) ;;",
            "    *) exit 0 ;;",
            "esac",
            "",
            "SCRIPT_DIR=\"${CLONED_SOURCE_PACKAGES_DIR:-${BUILD_DIR%/Build/*}/SourcePackages}\"",
            "if [ ! -x \"${SCRIPT_DIR}/checkouts/firebase-ios-sdk/Crashlytics/run\" ]; then",
            "  SCRIPT_DIR=\"${BUILD_DIR%/Build/*}/SourcePackages\"",
            "fi",
            "",
            "\"${SCRIPT_DIR}/checkouts/firebase-ios-sdk/Crashlytics/run\"",
            "",
          ],
        },
      ],
      "package-product-members": [
        {
          "product-name": "KeeperCore",
          "build-phase": { "build-phase": "copy/Embed Frameworks", "code-sign-on-copy": true },
        }, {
          "product-name": "KeeperCore",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "TKBase",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "TKUIKit",
          "build-phase": { "build-phase": "copy/Embed Frameworks", "code-sign-on-copy": true },
        }, {
          "product-name": "TKUIKit",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "App",
          "product-name": "App",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "Stories",
          "product-name": "TKStories",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "TKCoordinator",
          "product-name": "TKCoordinator",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "TKCore",
          "product-name": "TKCore",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "TKScreenKit",
          "product-name": "TKScreenKit",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "ios-branch-sdk-spm",
          "product-name": "BranchSDK",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "linkrunner-ios",
          "product-name": "LinkrunnerKitStatic",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "AppsFlyerFramework",
          "product-name": "AppsFlyerLib",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "${ICON_NAME}",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "Configurations/Entitlements/Keeper.entitlements",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "$(BUILD_NUMBER)",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Keeper/Resources/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "$(BUNDLE_DISPLAY_NAME)",
        "INFOPLIST_KEY_ITSAppUsesNonExemptEncryption": "NO",
        "INFOPLIST_KEY_NSBluetoothAlwaysUsageDescription": "Keeper uses Bluetooth to connect your Ledger Nano X, Stax, Flex or Nano Gen5",
        "INFOPLIST_KEY_NSCameraUsageDescription": "Keeper uses camera to scan QR codes",
        "INFOPLIST_KEY_NSFaceIDUsageDescription": "Keeper uses biometric authentication to authorize transactions",
        "INFOPLIST_KEY_NSMicrophoneUsageDescription": "Microphone access is required for identity verification.",
        "INFOPLIST_KEY_NSPhotoLibraryAddUsageDescription": "Keeper saves images to your photo library",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UILaunchStoryboardName": "LaunchScreen",
        "INFOPLIST_KEY_UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations": "UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight UIInterfaceOrientationPortrait",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "$(APP_VERSION)",
        "PRODUCT_BUNDLE_IDENTIFIER": "$(PRODUCT_BUNDLE_IDENTIFIER)",
        "PRODUCT_NAME": "$(BUNDLE_DISPLAY_NAME)",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "YES",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1",
      },
    }, {
      "name": "KeeperWidgetExtension",
      "id": "7D3F25D92AC19417002DF1B7",
      "product": "Products/KeeperWidgetExtension.appex",
