# Wallet profiles for local Maestro QA runs. Copy to wallets.env (gitignored),
# fill in, never commit. tools/qa_run.sh --wallet <profile> maps
# WALLET_<PROFILE> / WALLET_<PROFILE>_ADDR onto WALLET_WITH_MONEY /
# WALLET_WITH_MONEY_ADDR — the variables the shared steps and the on-chain
# asserts use — and primes the simulator pasteboard with the phrase, because the
# import screen's Paste button reads UIPasteboard (Maestro setClipboard does not).
#
# Profiles (one seed per "fraction" of the product, same names as the CI secrets):
#   MULTICHAIN  BIP39 12/24 words that is NOT a valid TON phrase — imports straight
#               into a multichain wallet (CI: MAESTRO_MC_WALLET_MONEY*; shards
#               backup, portfolio, wallet, send, trade, staking, …).
#   TON_ONLY    24-word TON mnemonic — imports as a legacy TON wallet through
#               "Choose wallet → TON wallet" (CI: MAESTRO_WALLET_WITH_MONEY*; the
#               ton_* shards: ton_battery, ton_browser, ton_tonconnect, …).
#   TON_V4      TON v3/v4 phrase for the import picker itself (CI: MAESTRO_TON_V4,
#               steps/import_wallet_ton_v3.yaml / _v4.yaml).
# Use small funded test wallets owned by the team; never a public phrase, never
# a customer's.

WALLET_MULTICHAIN="word1 ... word12"
WALLET_MULTICHAIN_ADDR="UQ..."
WALLET_TON_ONLY="word1 word2 ... word24"
WALLET_TON_ONLY_ADDR="UQ..."
WALLET_TON_V4="word1 ... word24"
WALLET_TON_V4_ADDR="UQ..."

# Passcode digit used by steps/password/enter_password.yaml (4 identical digits).
PASSWORD_KEY=5
# TonAPI bearer for scripts/api/** (service/** asserts); passed as -e auth=.
MAESTRO_AUTH=""
# Recipient for send-to-self flows.
RECIEVE_WALLET="UQ..."
# Testnet phrase for the testnet flows.
TESTNET_MNEM=""
